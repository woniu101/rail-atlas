---
import '../styles/global.css';
import '../styles/refinement.css';
import Icon from '../components/Icon.astro';
import BrandMark from '../components/BrandMark.astro';
import {url} from '../lib/paths';
interface Props { title?: string; description?: string; wide?: boolean; noindex?: boolean; }
const { title = '铁道图鉴 · 每一列火车，都有一段故事。', description = '一位铁路爱好者的线上收藏。从蒸汽时代到复兴号，探索中国铁路的车型、技术与故事。', noindex = false } = Astro.props;
const path = Astro.url.pathname;
const nav = [['探索车型','trains/'],['铁路原理','principles/'],['发展历程','history/'],['世界铁路','world/']];
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#f7f5f0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="preload" as="font" type="font/woff2" href={url('fonts/rail-serif.woff2')} crossorigin />
    <title>{title}</title>
  </head>
  <body class:list={{'home-page':path===url()}}>
    <a class="skip-link" href="#main">跳至主要内容</a>
    <header class="site-header" data-pagefind-ignore>
      <div class="header-inner">
        <a href={url()} class="brand" aria-label="铁道图鉴首页"><BrandMark/><span class="brand-wordmark">铁道图鉴<small>中国铁路 · 互动图鉴</small></span></a>
        <nav class="desktop-nav" aria-label="主导航">{nav.map(([label, href]) => <a href={url(href)} class:list={{active:path.includes(`/${href.split('/')[0]}/`)}} aria-current={path.includes(`/${href.split('/')[0]}/`) ? 'page' : undefined}>{label}</a>)}</nav>
        <div class="header-actions"><a class="search-link" href={url('search/')} aria-label="搜索车型与文章"><Icon name="search"/><span>搜索车型</span><kbd>/</kbd></a><button class="menu-toggle icon-button" aria-label="打开导航" aria-expanded="false" aria-controls="mobile-nav"><Icon name="menu"/></button></div>
      </div>
      <nav id="mobile-nav" class="mobile-nav" hidden aria-label="移动导航">{nav.map(([label, href]) => <a href={url(href)}>{label}</a>)}<a href={url('search/')}>搜索车型与文章</a></nav>
    </header>
    <main id="main" data-pagefind-body={noindex?undefined:true}><slot /></main>
    <footer class="site-footer" data-pagefind-ignore>
      <div class="footer-top"><a href={url()} class="brand footer-brand"><BrandMark/><span>铁道图鉴</span></a><p>记录车轮驶过的时代，也记录对铁路的热爱。</p><a href={url('about/')}>关于本站与素材说明</a></div>
      <div class="footer-bottom"><span>一个持续生长的个人铁路图鉴 · 非商业兴趣项目</span><span>始于热爱 · 持续探索</span></div>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const mobile = document.querySelector<HTMLElement>('#mobile-nav');
      toggle?.addEventListener('click', () => {
        const expanded = toggle.getAttribute('aria-expanded') !== 'true';
        toggle.setAttribute('aria-expanded', String(expanded));
        toggle.setAttribute('aria-label', expanded ? '关闭导航' : '打开导航');
        if(mobile) mobile.hidden = !expanded;
      });
      document.addEventListener('keydown', (e) => {
        if(e.key === 'Escape' && mobile && !mobile.hidden && toggle) {mobile.hidden = true; toggle.setAttribute('aria-expanded', 'false'); toggle.setAttribute('aria-label','打开导航'); toggle.focus();}
        const el = e.target as HTMLElement;
        if(e.key === '/' && !e.ctrlKey && !e.metaKey && !el.matches('input,textarea,[contenteditable]')) {
          e.preventDefault(); document.querySelector<HTMLAnchorElement>('.search-link')?.click();
        }
      });
    </script>
  </body>
</html>
